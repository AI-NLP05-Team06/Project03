+    def normalized_rechunk_preview(
+        chunks: Sequence[Mapping[str, Any]], *, source_url: str, document_ids: set[str]
+    ) -> list[dict[str, Any]]:
+        """새 청크를 기존 도메인/문서 ID 규칙으로 안전하게 발급한다.
+
+        예를 들어 문서 ID가 DP-002이면 항상 DP-002_chunk_000 형식으로
+        다시 번호를 매긴다. URL 재청킹이므로 NEW- 접두어를 만들지 않으며,
+        다른 문서 ID가 섞인 결과는 반영하지 않는다.
+        """
+        candidates: list[dict[str, Any]] = []
+        for raw in chunks:
+            chunk = copy.deepcopy(dict(raw))
+            document_id = _clean(chunk.get("document_id"))
+            if document_id not in document_ids:
+                continue
+            chunk["document_id"] = document_id
+            chunk["parent_doc_id"] = _clean(chunk.get("parent_doc_id")) or document_id
+            chunk["source_url"] = source_url
+            candidates.append(chunk)
+        if not candidates:
+            raise ValueError("재수집 결과에서 선택한 URL의 청크를 찾지 못했습니다. 매니페스트 문서_ID와 URL 연결을 확인해 주세요.")
+        def ordering_index(row: Mapping[str, Any]) -> int:
+            try:
+                return int(row.get("chunk_index") or 0)
+            except (TypeError, ValueError):
+                return 0
+
+        candidates.sort(key=lambda row: (
+            _clean(row.get("document_id")),
+            ordering_index(row),
+            _clean(row.get("chunk_id")),
+        ))
+        counters: dict[str, int] = {}
+        normalized: list[dict[str, Any]] = []
+        for chunk in candidates:
+            document_id = str(chunk["document_id"])
+            index = counters.get(document_id, 0)
+            counters[document_id] = index + 1
+            chunk["chunk_id"] = f"{document_id}_chunk_{index:03d}"
+            chunk["chunk_index"] = index
+            chunk["title"] = _clean(chunk.get("title"))
+            chunk["section_title"] = _clean(chunk.get("section_title"))
+            chunk["business_function"] = _clean(chunk.get("business_function"))
+            chunk["content"] = str(chunk.get("content") or "").strip()
+            if not chunk["content"]:
+                continue
+            normalized.append(chunk)
+        if not normalized:
+            raise ValueError("재수집 결과의 본문이 비어 있어 청크를 만들지 않았습니다.")
+        return normalized
+
+    def rechunk_public(row: Mapping[str, Any], *, include_preview: bool = False) -> dict[str, Any]:
+        out = {
