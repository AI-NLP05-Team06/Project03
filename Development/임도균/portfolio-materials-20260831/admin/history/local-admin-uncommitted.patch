 function keysView(){const k=state.keyStatus||{};const tested=state.keyTest?`<div class="key-test-result"><b>연결 검증 완료</b><span>지문 ${esc(state.keyTest.fingerprint)}</span><span>임베딩 ${Math.round(state.keyTest.embedding_latency_ms)}ms</span><span>답변 ${Math.round(state.keyTest.chat_latency_ms)}ms</span></div>`:'';return `${heading('SERVER SECRET','HCX API 키 관리','키는 HTTPS로 AWS 서버에 전달되며 화면·API 응답·로그에서 다시 조회할 수 없습니다.')}<section class="metric-grid">${metric('설정 상태',k.configured?'등록됨':'미등록',k.source||'—')}${metric('키 지문',k.fingerprint||'—','SHA-256 앞 12자리','purple')}${metric('마지막 교체',k.last_rotated_at?new Date(k.last_rotated_at*1000).toLocaleString('ko-KR'):'교체 이력 없음','AWS 서버','cyan')}${metric('저장 범위','AWS 영구 설정','런타임·systemd 재시작 유지','red')}</section><div class="risk-banner"><b>!</b><span><strong>기존 키는 확인하거나 복사할 수 없습니다.</strong>새 키는 연결 검증 후 현재 챗봇과 AWS 환경파일에 함께 반영됩니다.</span></div><section class="panel key-manager"><div class="panel-head"><div><span class="section-kicker">ROTATE SECRET</span><h2>새 HCX API 키</h2></div><span class="index-health">AWS 서버 전용</span></div><label><span>API 키</span><div class="secret-input"><input id="new-api-key" type="password" autocomplete="new-password" spellcheck="false" placeholder="Bearer 없이 키 값만 입력"><button class="secondary-btn" data-action="toggle-key">보기</button></div></label><label><span>교체 확인 문구</span><input id="key-confirm" placeholder="API 키 교체"></label><div class="approve-bar"><button class="secondary-btn" data-action="test-key">연결 테스트</button><button class="danger-btn" data-action="rotate-key">검증 후 교체</button></div>${tested}<p class="muted-note">연결 테스트는 BGE-M3 임베딩과 HCX 답변 모델에 각각 짧은 요청을 1회 실행합니다.</p></section>`;}
 
